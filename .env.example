# Admin password for accessing admin.html dashboard
ADMIN_PASSWORD=your_admin_password_here

# Shared password that all students use to take the test
STUDENT_PASSWORD=test-password-here

# GitHub configuration (optional - for sync features)
GITHUB_OWNER=your_github_username
GITHUB_REPO=your_repo_name
GITHUB_BRANCH=main
GITHUB_TOKEN=your_github_token_here

# Environment
NODE_ENV=production
